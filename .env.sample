# Copy to .env (gitignored) and fill in. scripts/train/slurm_job.sh loads it before every
# job and srun passes it into the container. Keep CUDA_LAUNCH_BLOCKING out of here: it
# serializes every kernel launch and cripples Isaac Lab training.
HF_TOKEN=
WANDB_API_KEY=
WANDB_ENTITY=
HF_HOME=/mnt/beegfs/shared/hfm/cache
TORCH_HOME=/mnt/beegfs/shared/hfm/cache
TOKENIZERS_PARALLELISM=false
# Setup proxy if needed
# HTTPS_PROXY=socks5://127.0.0.1:7891
# HTTP_PROXY=socks5://127.0.0.1:7891
